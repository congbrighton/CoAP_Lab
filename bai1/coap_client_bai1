import asyncio
from aiocoap import Context, Message, GET, POST

async def main():
    protocol = await Context.create_client_context()
    uri = 'coap://localhost:5683/iot/lab/message'

    print("CoAP Client")
    print("Sending GET request...")
    print(f"URI: {uri}\n")

    # 1. Gửi GET Request
    req_get = Message(code=GET, uri=uri)
    try:
        res_get = await protocol.request(req_get).response
        print("Response:")
        print(f"Code: {res_get.code}")
        print(f"Payload: {res_get.payload.decode('utf-8')}\n")
    except Exception as e:
        print(f"Lỗi khi gửi GET: {e}\n")

    # 2. Gửi POST Request
    post_payload = "Xin chao tu CoAP Client - B23DCCN001 - Nguyen Van A"
    print("Sending POST request...")
    print(f"Payload: {post_payload}\n")

    req_post = Message(code=POST, uri=uri, payload=post_payload.encode('utf-8'))
    try:
        res_post = await protocol.request(req_post).response
        print("Response:")
        print(f"Code: {res_post.code}")
        print(f"Payload: {res_post.payload.decode('utf-8')}")
    except Exception as e:
        print(f"Lỗi khi gửi POST: {e}")

if __name__ == "__main__":
    asyncio.run(main())
