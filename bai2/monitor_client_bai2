import asyncio
import json
import datetime
from aiocoap import Context, Message, GET

async def main():
    protocol = await Context.create_client_context()
    uri = 'coap://localhost:5683/iot/lab/sensor01/data'

    print("Monitoring CoAP Client started. Press Ctrl+C to stop.\n")

    while True:
        try:
            req = Message(code=GET, uri=uri)
            res = await protocol.request(req).response
            now = datetime.datetime.now().strftime("%H:%M:%S")

            data = json.loads(res.payload.decode('utf-8'))
            temp = data.get("temperature", 0)
            hum = data.get("humidity", 0)
            dev_id = data.get("device_id", "unknown")

            print(f"[{now}] Received sensor data")
            print(f"Device: {dev_id}")
            print(f"Temperature: {temp} C")
            print(f"Humidity: {hum} %")

            has_warning = False
            if temp > 35.0:
                print("CANH BAO: Nhiet do cao")
                has_warning = True
            if hum < 40.0:
                print("CANH BAO: Do am thap")
                has_warning = True

            if not has_warning:
                print("Trang thai: Binh thuong")

            print("-" * 30)

        except Exception as e:
            print(f"Lỗi truy vấn Server: {e}")

        await asyncio.sleep(3)

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\nMonitoring stopped.")
